# 路合开奖 H5 部署示例（Nginx）
# 1. yarn build，把 app/ 拷到服务器，例如 /var/www/luhe-app
# 2. 把下面的 server 块放进 nginx 配置，按实际修改域名、路径和后端地址后 nginx -s reload

server {
    listen       80;
    server_name  h5.example.com;

    root   /var/www/luhe-app;
    index  index.html;

    # 接口：/api/xxx 转发到 luhe-app（C端服务）的 /xxx。proxy_pass 结尾的 / 会去掉 /api 前缀，不能省略
    location /api/ {
        proxy_pass         http://127.0.0.1:8061/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # 图库图片：后端返回 /profile/... 相对路径，文件在后台的上传目录（luhe.profile，默认 /data/luhe/uploadPath）
    # 方式一（推荐，nginx 与后端在同一台机器）：直接读目录
    location /profile/ {
        alias   /data/luhe/uploadPath/;
        expires 7d;
    }
    # 方式二（nginx 与后端不在同一台机器）：换成下面这段，转发给 luhe-app
    # location /profile/ {
    #     proxy_pass http://127.0.0.1:8061;
    # }

    # 前端路由（history 模式）：找不到的路径回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # PWA：Service Worker 和清单不能被缓存，否则用户收不到新版本（autoUpdate 依赖它们）
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Android 安装包：把 release/luhe-x.y.z.apk 上传为 /var/www/luhe-download/luhe.apk
    location /download/ {
        alias /var/www/luhe-download/;
        types { application/vnd.android.package-archive apk; }
        add_header Cache-Control "no-cache";
    }

    # 带哈希的静态资源长期缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
