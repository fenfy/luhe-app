# 复制为 .env.local 后按需修改（.env.local 不提交）

# 不设置或 false：请求 luhe 后端真实接口；true：使用本地 mock 数据（离线开发）
VITE_USE_MOCK=false

# 浏览器请求接口的前缀。开发时保持 /api（由 Vite 代理）；
# 生产环境改成网关地址，如 https://api.example.com 或由 Nginx 把 /api 转发到 luhe-app
VITE_API_BASE=/api

# 开发时 /api 代理到的 luhe-app（C端服务）地址
VITE_API_PROXY=http://localhost:8061

# 图库图片地址前缀：后端返回 /profile/... 相对路径。默认留空 = 与页面同域
# （开发时 Vite 把 /profile 代理到 luhe-app，生产环境由 Nginx 提供 /profile/，见 README）
VITE_FILE_BASE=

# Android 浏览器底部「下载 App」按钮的 APK 地址，默认 /download/luhe.apk（见 deploy/nginx.conf.example）
VITE_APK_URL=/download/luhe.apk
